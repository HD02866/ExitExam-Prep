# ==============================================================================
# EXITEXAM PREP — Environment Variables Template
# ==============================================================================
# Obtain these from your Supabase Project Settings -> API:
# 1. Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Project Anon Key (Safe for browser / public client)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 3. Project Service Role Key (STRICTLY SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
# Used for Admin user provisioning (creating/inviting instructors, deactivating accounts)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 4. Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
