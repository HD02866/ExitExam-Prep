# ==============================================================================
# EXITEXAM PREP — Environment Variables Template
# ==============================================================================

# --- PostgreSQL & PgBouncer Configuration (Self-Hosted Architecture) ---
# 1. Primary pooled connection for application queries (via PgBouncer in production)
DATABASE_URL="postgresql://postgres:password@localhost:6432/exitexam_prep?sslmode=disable"

# 2. Direct connection for Drizzle Kit migrations (bypasses PgBouncer transaction pooler)
DATABASE_DIRECT_URL="postgresql://postgres:password@localhost:5432/exitexam_prep?sslmode=disable"

# 3. Connection pool parameters
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# --- Better Auth Configuration (Phase B Target) ---
BETTER_AUTH_SECRET="replace-with-a-secure-32-character-random-secret-key"
BETTER_AUTH_URL="http://localhost:3000"

# --- Supabase Legacy / Coexistence Configuration ---
# Retained during phased migration; do not remove until auth transition completes
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
NEXT_PUBLIC_APP_URL=http://localhost:3000
